    "@types/howler": "^2.2.12",
    "@types/node": "^22.18.8",
    "@types/three": "^0.180.0",
    "draco3dgltf": "^1.5.7",
    "playwright-core": "^1.55.1",
    "sharp": "^0.34.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
